# --- Nebius Token Factory (OpenAI-compatible) -------------------------------
# Get a key from the Token Factory console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Agent model roles -------------------------------------------------------
# Run `tf-migrate preflight` first: the supervisor MUST pass the tool-calling
# checks, the judge MUST pass a structured-output check. Don't assume — verify.
SUPERVISOR_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
JUDGE_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Fallback candidate pool the planner uses when its own catalog picks fail
# validation (comma-separated Token Factory model ids).
CANDIDATE_POOL=Qwen/Qwen3-30B-A3B-Instruct-2507,google/gemma-3-27b-it

# Max evaluate->judge->supervise rounds (1 = no retries, 2 = one fix retry).
MAX_ITERATIONS=2
REQUEST_TIMEOUT_S=120

# --- Optional: LangSmith tracing --------------------------------------------
# The agent always writes a local decision log + evidence under runs/<ts>/.
# For a full graph trace UI, set these (works with a free LangSmith account):
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tf-migration-agent
